{
  "name": "mcp-explorer",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Desktop workbench for MCP servers",
  "main": "dist/main/main.mjs",
  "scripts": {
    "build": "npm run build:protocol && npm run build:storage && npm run build:platform && npm run build:backend && npm run build:app && npm run build:renderer",
    "build:protocol": "tsc -p packages/protocol/tsconfig.json",
    "build:storage": "tsc -p packages/storage/tsconfig.json",
    "build:platform": "tsc -p packages/platform/tsconfig.json",
    "build:backend": "tsc -p packages/backend/tsconfig.json",
    "build:app": "tsc -p tsconfig.json",
    "build:renderer": "tsc -p app/renderer/tsconfig.json && vite build -c app/renderer/vite.config.mts --logLevel warn",
    "dev:renderer": "vite -c app/renderer/vite.config.mts",
    "start": "npm run build && electron .",
    "pack:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "test": "node --test \"test/*.test.mjs\"",
    "test:smoke": "node --test --test-concurrency=1 --test-timeout=180000 \"test/smoke/*.test.mjs\"",
    "probe:seam": "node scripts/probe-seam.mjs",
    "probe:fallback": "node scripts/probe-fallback.mjs",
    "check:macos-prebuilds": "node scripts/check-macos-prebuilds.mjs",
    "capture:real": "node scripts/capture-real.mjs",
    "golden:db": "node scripts/golden-db.mjs",
    "golden:versions": "node scripts/golden-versions.mjs",
    "icons": "electron scripts/build-icons.cjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@napi-rs/keyring": "2.1.0",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "gpt-tokenizer": "4.0.0",
    "jsonc-parser": "3.3.1"
  },
  "build": {
    "appId": "com.mtgeekman.mcpexplorer",
    "productName": "MCP Explorer",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*",
      "packages/*/package.json",
      "packages/*/dist/**/*"
    ],
    "extraResources": [
      { "from": "build/icon.png", "to": "icon.png" }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3-multiple-ciphers/**",
      "**/node_modules/@napi-rs/keyring-*/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Michael Knudson <mtgeekman@gmail.com>"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "npmRebuild": false
  },
  "author": {
    "name": "Michael Knudson",
    "email": "mtgeekman@gmail.com"
  },
  "homepage": "https://gitlab.mtgeekman.com/mcp-servers/mcpexplorer",
  "repository": {
    "type": "git",
    "url": "https://gitlab.mtgeekman.com/mcp-servers/mcpexplorer.git"
  }
}
