{
  "mcpServers": {
    "notes": {
      "command": "node",
      "args": ["${userHome}/notes-mcp/index.js"],
      "env": { "NOTES_API_KEY": "${env:NOTES_API_KEY}", "NOTES_PASSWORD": "hunter2" }
    },
    "remote": {
      "url": "https://example.com/mcp",
      "headers": { "Authorization": "Bearer abc123" },
